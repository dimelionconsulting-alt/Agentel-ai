# App
NEXT_PUBLIC_APP_NAME=Agentel AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Demo mode renders the dashboard shell without Supabase credentials.
# Set to false and configure Supabase for real authentication.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (server only)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TEXT_MODEL=gpt-4o-mini

# Twilio (server only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=false

# Voice gateway (Railway/Render/AWS)
VOICE_GATEWAY_PORT=8081
VOICE_GATEWAY_WS_URL=wss://localhost:8081/streams
NEXT_PUBLIC_VOICE_GATEWAY_WS_URL=wss://localhost:8081/streams

# Stripe (server only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=

# Security
CREDENTIALS_ENCRYPTION_KEY=replace-with-long-random-string
